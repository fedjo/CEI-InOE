        },
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0
      },
      "pluginVersion": "12.3.2",
      "targets": [
        {
          "dataset": "ocei3",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH hourly_thi AS (\n    SELECT \n        date_trunc('hour', \"timestamp\") AS hr,\n        -- Using the NRC Livestock Formula\n        AVG((1.8 * temperature + 32) - ((0.55 - 0.0055 * humidity) * (1.8 * temperature - 26))) AS avg_thi\n    FROM environmental_metrics as env\n    JOIN generic_device as d ON d.id = CAST(env.source_device_id AS INT)\n    WHERE \n        $__timeFilter(\"timestamp\") \n        -- Equality filter for the dashboard variable\n        AND d.client = '$site_name' \n    GROUP BY 1, d.client\n)\nSELECT \n    date_trunc('day', hr) AS \"time\",\n    COUNT(*) FILTER (WHERE avg_thi < 65) AS \"Recovery Hours (Optimal)\",\n    COUNT(*) FILTER (WHERE avg_thi >= 68) AS \"Stress Hours (THI > 68)\",\n    COUNT(*) FILTER (WHERE avg_thi >= 72) AS \"Danger Hours (THI > 72)\"\nFROM hourly_thi\nGROUP BY 1\nORDER BY 1;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Cumulative Heat Load (Daily Hours of Heat Stress)",
      "type": "barchart"
    },

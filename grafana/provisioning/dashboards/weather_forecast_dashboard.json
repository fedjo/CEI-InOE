      },
      "pluginVersion": "12.3.2",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres_default"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH latest_run AS (\n  SELECT MAX(forecast_run_at) AS forecast_run_at\n  FROM fact_weather_forecast\n  WHERE site_id = 1\n)\nSELECT\n  f.valid_at AS \"time\",\n  f.temperature_2m_c AS value\nFROM fact_weather_forecast f\nJOIN latest_run lr ON f.forecast_run_at = lr.forecast_run_at\nWHERE f.site_id = 1\n  AND f.valid_at >= NOW()\nORDER BY f.valid_at\nLIMIT 1;",
          "refId": "A"
        }
      ],
      "title": "Next Hour Temperature",
      "type": "stat"
    },

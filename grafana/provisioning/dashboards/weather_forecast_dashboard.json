          "rawSql": "WITH latest_run AS (\n  SELECT MAX(forecast_run_at) AS forecast_run_at\n  FROM fact_weather_forecast\n  WHERE site_id = 1\n)\nSELECT\n  f.valid_at,\n  f.horizon_hours,\n  ROUND(f.temperature_2m_c::numeric, 1) AS temperature_c,\n  ROUND(COALESCE(f.precipitation_mm, 0)::numeric, 1) AS precipitation_mm,\n  ROUND(f.cloud_cover_pct::numeric, 0) AS cloud_cover_pct,\n  f.weather_code,\n  f.is_day\nFROM fact_weather_forecast f\nJOIN latest_run lr ON f.forecast_run_at = lr.forecast_run_at\nWHERE f.site_id = 1\n  AND f.valid_at BETWEEN $__timeFrom() AND $__timeTo()\nORDER BY f.valid_at\nLIMIT 48;",
          "refId": "A"
        }
      ],
      "title": "Forecast Table",
      "type": "table"
    }

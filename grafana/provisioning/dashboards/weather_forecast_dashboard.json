          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH latest_run AS (\n  SELECT MAX(forecast_run_at) AS forecast_run_at\n  FROM fact_weather_forecast\n  WHERE site_id = 1\n)\nSELECT\n  f.valid_at AS \"time\",\n  COALESCE(f.precipitation_mm, 0) AS value\nFROM fact_weather_forecast f\nJOIN latest_run lr ON f.forecast_run_at = lr.forecast_run_at\nWHERE f.site_id = 1\n  AND f.valid_at >= NOW()\nORDER BY f.valid_at\nLIMIT 1;",

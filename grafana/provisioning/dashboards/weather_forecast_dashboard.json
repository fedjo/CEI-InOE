          "editorMode": "code",
          "format": "time_series",
          "legendFormat": "{{metric}}",
          "rawQuery": true,
          "rawSql": "WITH latest_run AS (\n  SELECT MAX(forecast_run_at) AS forecast_run_at\n  FROM fact_weather_forecast\n  WHERE site_id = 1\n), forecast AS (\n  SELECT *\n  FROM fact_weather_forecast f\n  JOIN latest_run lr ON f.forecast_run_at = lr.forecast_run_at\n  WHERE f.site_id = 1\n    AND f.valid_at BETWEEN $__timeFrom() AND $__timeTo()\n)\nSELECT valid_at AS \"time\", 'Shortwave radiation' AS metric, shortwave_radiation_wm2 AS value\nFROM forecast\nUNION ALL\nSELECT valid_at AS \"time\", 'Direct normal irradiance' AS metric, direct_normal_irradiance_wm2 AS value\nFROM forecast\nUNION ALL\nSELECT valid_at AS \"time\", 'Diffuse radiation' AS metric, diffuse_radiation_wm2 AS value\nFROM forecast\nUNION ALL\nSELECT valid_at AS \"time\", 'Tilted irradiance' AS metric, global_tilted_irradiance_wm2 AS value\nFROM forecast\nORDER BY 1, 2;",
          "refId": "A"
        }
      ],
      "title": "Solar Irradiance Forecast",
      "type": "timeseries"

# CEI-InOE Datasource Registry
# Loaded on ingestor startup — each entry is upserted by external_id.
#
# SETUP: Copy this file to datasources.yaml and fill in real device_token values.
#        datasources.yaml is gitignored; never commit real tokens.

datasources:

  # --- File-based sources ---
  - external_id: lelyna
    source_category: file
    data_type: milk
    alias: farm milking system 1
    client: LK Dairy Farm
    status: offline
    metadata: {}

  - external_id: delaval
    source_category: file
    data_type: milk
    alias: farm milking system 2
    client: Blue Farm Dairy
    status: offline
    metadata: {}

  # --- Blue Farm Dairy energy meters (Tago.io API) ---
  - external_id: "68f1fb6550bcae000b4c2501"
    source_category: api
    data_type: energy
    alias: DB-Fan Main
    client: Blue Farm Dairy
    status: offline
    metadata:
      name: eastron_sdm630_9372
      alias: DB-Fan Main
      device_token: <DEVICE_TOKEN_HERE>


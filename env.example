# CEI-InOE Environment Configuration
# Copy this file to .env and modify as needed

# ============================================================================
# Database Configuration
# ============================================================================
DB_DSN=postgres://ocei:ocei@localhost:5432/ocei3

# ============================================================================
# Worker Configuration
# ============================================================================
NUM_WORKERS=2
QUEUE_MAX_SIZE=100

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO

# ============================================================================
# File Connector Configuration
# ============================================================================
WATCH_DIR=/data/incoming
PROCESSED_DIR=/data/processed
REJECTED_DIR=/data/rejected
MAPPINGS_DIR=/app/mappings
FILE_POLL_INTERVAL=5
FILE_STABLE_SECONDS=3

# ============================================================================
# HTTP Connector Configuration (Example)
# ============================================================================
ENERGY_API_URL=https://api.example.com
ENERGY_API_KEY=

# ============================================================================
# Airbeld API Configuration
# ============================================================================
AIRBELD_API_URL=http://api.example.com
AIRBELD_EMAIL=
AIRBELD_PASSWORD=
AIRBELD_POLL_INTERVAL=43200
AIRBELD_LOOKBACK_DAYS=180

# ============================================================================
# Tago.io Energy API Configuration
# ============================================================================
TAGO_API_URL=http://api.example.com
TAGO_POLL_INTERVAL=3600
TAGO_LOOKBACK_DAYS=180
TAGO_DEFAULT_QTY=100000
TAGO_ENABLED=true

# ============================================================================
# FusionSolar API Configuration
# ============================================================================
FUSIONSOLAR_API_URL=http://api.example.com
FUSIONSOLAR_USER=
FUSIONSOLAR_SYSTEM_CODE=
FUSIONSOLAR_POLL_INTERVAL=3600
FUSIONSOLAR_LOOKBACK_DAYS=30
FUSIONSOLAR_ENABLED=true

# ============================================================================
# Open-Meteo Forecast API Configuration
# ============================================================================
OPEN_METEO_LATITUDE=
OPEN_METEO_LONGITUDE=
OPEN_METEO_PANEL_TILT=30
OPEN_METEO_PANEL_AZIMUTH=0
OPEN_METEO_FORECAST_DAYS=7
OPEN_METEO_POLL_INTERVAL=3600
OPEN_METEO_MODEL=best_match
OPEN_METEO_ENABLED=true

# ============================================================================
# Site Configuration
# ============================================================================
# Selects which site (set of datasources) to activate on ingestor startup.
# Valid values: blue_farm | lk_farm | charalambides
ACTIVE_SITE=blue_farm

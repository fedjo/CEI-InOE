# CEI-InOE Environment Configuration
# Generated by Ansible - DO NOT EDIT MANUALLY

# ============================================================================
# Database Configuration
# ============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME={{ cei_inoe_db_name }}
DB_USER={{ cei_inoe_db_user }}
DB_PASSWORD={{ cei_inoe_db_password }}

# Database URLs for API and Ingestor
DATABASE_URL=postgresql://{{ cei_inoe_db_user }}:{{ cei_inoe_db_password }}@postgres:5432/{{ cei_inoe_db_name }}
DB_DSN=postgresql://{{ cei_inoe_db_user }}:{{ cei_inoe_db_password }}@postgres:5432/{{ cei_inoe_db_name }}

# ============================================================================
# API Configuration
# ============================================================================
API_KEY={{ cei_inoe_api_key }}
CORS_ORIGINS={{ cei_inoe_cors_origins | join(',') }}

# ============================================================================
# Worker Configuration
# ============================================================================
NUM_WORKERS={{ cei_inoe_num_workers }}
QUEUE_MAX_SIZE={{ cei_inoe_queue_max_size }}

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL={{ cei_inoe_log_level }}

# ============================================================================
# File Connector Configuration
# ============================================================================
WATCH_DIR={{ cei_inoe_watch_dir }}
PROCESSED_DIR={{ cei_inoe_processed_dir }}
REJECTED_DIR={{ cei_inoe_rejected_dir }}
MAPPINGS_DIR={{ cei_inoe_mappings_dir }}
FILE_POLL_INTERVAL={{ cei_inoe_file_poll_interval }}
FILE_STABLE_SECONDS={{ cei_inoe_file_stable_seconds }}

# ============================================================================
# HTTP Connector Configuration
# ============================================================================
ENERGY_API_URL={{ cei_inoe_energy_api_url }}
ENERGY_API_KEY={{ cei_inoe_energy_api_key }}

# ============================================================================
# Airbeld API Configuration
# ============================================================================
AIRBELD_API_URL={{ cei_inoe_airbeld_api_url }}
AIRBELD_EMAIL={{ cei_inoe_airbeld_email }}
AIRBELD_PASSWORD={{ cei_inoe_airbeld_password }}
AIRBELD_POLL_INTERVAL={{ cei_inoe_airbeld_poll_interval }}
AIRBELD_LOOKBACK_DAYS={{ cei_inoe_airbeld_lookback_days }}

# ============================================================================
# Tago.io Energy API Configuration
# ============================================================================
TAGO_API_URL={{ cei_inoe_tago_api_url }}
TAGO_ENABLED={{ cei_inoe_tago_enabled | ternary('true', 'false') }}
TAGO_POLL_INTERVAL={{ cei_inoe_tago_poll_interval }}
TAGO_LOOKBACK_DAYS={{ cei_inoe_tago_lookback_days }}

# ============================================================================
# FusionSolar API Configuration
# ============================================================================
FUSIONSOLAR_API_URL={{ cei_inoe_fusionsolar_api_url }}
FUSIONSOLAR_USER={{ cei_inoe_fusionsolar_user }}
FUSIONSOLAR_SYSTEM_CODE={{ cei_inoe_fusionsolar_system_code }}
FUSIONSOLAR_ENABLED={{ cei_inoe_fusionsolar_enabled | ternary('true', 'false') }}
FUSIONSOLAR_POLL_INTERVAL={{ cei_inoe_fusionsolar_poll_interval }}
FUSIONSOLAR_LOOKBACK_DAYS={{ cei_inoe_fusionsolar_lookback_days }}

# ============================================================================
# Open-Meteo Forecast API Configuration
# ============================================================================
OPEN_METEO_ENABLED={{ cei_inoe_openmeteo_enabled | ternary('true', 'false') }}
OPEN_METEO_LATITUDE={{ cei_inoe_openmeteo_latitude }}
OPEN_METEO_LONGITUDE={{ cei_inoe_openmeteo_longitude }}
OPEN_METEO_PANEL_TILT={{ cei_inoe_openmeteo_panel_tilt }}
OPEN_METEO_PANEL_AZIMUTH={{ cei_inoe_openmeteo_panel_azimuth }}
OPEN_METEO_FORECAST_DAYS={{ cei_inoe_openmeteo_forecast_days }}
OPEN_METEO_POLL_INTERVAL={{ cei_inoe_openmeteo_poll_interval }}
OPEN_METEO_MODEL={{ cei_inoe_openmeteo_model }}
